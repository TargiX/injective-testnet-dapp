# Injective network to target. Defaults to 'mainnet'.
# Set to 'testnet' (chain injective-888) to trade on the public testnet using
# faucet funds — safe for testing perp margin/leverage math without real money.
# Faucet: https://testnet.faucet.injective.network/
NUXT_PUBLIC_NETWORK=mainnet

# Shared Websites PostHog project; public ingestion token, production host only.
NUXT_PUBLIC_POSTHOG_KEY=
